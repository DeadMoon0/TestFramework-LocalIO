<Project>

	<!-- Repository-wide conventions. Individual projects must not restate these, and must never
	     re-declare them behind a '$(Configuration)|$(Platform)' condition: such a block silently
	     drops the setting on every other configuration and platform. -->
	<PropertyGroup>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<LangVersion>latest</LangVersion>
	</PropertyGroup>

	<!-- Packaging and source-debugging conventions. -->
	<PropertyGroup>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>


  <!-- The package icon comes from the TestFramework-Common submodule. A clone without it would otherwise fail
       to pack with NuGet's opaque "icon not found"; this names the cause and the command that fixes it. -->
  <PropertyGroup>
    <PackageIconSourcePath>$(MSBuildThisFileDirectory)Modules\TestFramework-Common\Assets\Icon.png</PackageIconSourcePath>
  </PropertyGroup>

  <Target Name="EnsurePackageIconSubmoduleIsInitialized" BeforeTargets="GenerateNuspec" Condition="'$(PackageIcon)' != ''">
    <Error Condition="!Exists('$(PackageIconSourcePath)')"
           Text="The package icon &quot;$(PackageIconSourcePath)&quot; is missing because the TestFramework-Common submodule is not checked out. Run 'git submodule update --init --recursive' in the repository root and pack again." />
  </Target>

</Project>
