<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TestFramework.LocalIO</Title>
		<Version>0.4.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Manage your Local IO with a Framework Timeline.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-LocalIO</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-LocalIO.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Local;IO</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - FileArtifactReference.Observed() is removed, and teardown now deletes files a run discovered. FileArtifactFolderFinder previously marked its results observed, so a discovered file was never deleted; now it is an ordinary file reference and the timeline decides. Chain MarkReadonly() onto the FindArtifact / FindArtifacts call for a folder the run only reads. Requires TestFramework.Core 0.3.0.
What to change: replace Observed() with MarkReadonly() on the declaring call. A timeline that discovers files in a folder it does not own - a build output directory, a shared drop location - must add MarkReadonly() before upgrading, or teardown will delete those files.
Files the run creates itself, through UseRunDirectory() or SetupArtifact, are unaffected: they were removed at teardown before and still are.</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<PackageIconSourcePath>$(MSBuildThisFileDirectory)..\Modules\TestFramework-Common\Assets\Icon.png</PackageIconSourcePath>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!--
	  The package icon lives in the TestFramework-Common submodule. A clone that skips submodules
	  leaves it empty, and pack then fails with NuGet's opaque "icon file does not exist in the
	  package" / "Could not find a part of the path" error, which never mentions submodules.
	  Scoped to GenerateNuspec so ordinary builds and `dotnet test` stay unaffected.
	-->
	<Target Name="EnsurePackageIconSubmoduleIsInitialized" BeforeTargets="GenerateNuspec">
		<Error Condition="!Exists('$(PackageIconSourcePath)')"
		       Text="The package icon &quot;$(PackageIconSourcePath)&quot; is missing because the TestFramework-Common submodule is not checked out. Run 'git submodule update --init --recursive' in the repository root and pack again." />
	</Target>

	<ItemGroup>
	  <PackageReference Include="TestFramework.Core" Version="0.4.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
