<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TestFramework.LocalIO</Title>
		<Version>0.5.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Manage your Local IO with a Framework Timeline.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-LocalIO</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-LocalIO.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Local;IO</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>BREAKING - needs TestFramework.Core 0.7.0. AddFileArtifact no longer takes removeParentDirectoryIfEmpty (use FileRef(path).RemoveParentDirectoryIfEmpty()), FileArtifactData.Data is gone (read Content), and steps are built only through LocalIOExt and UseRunDirectory. New: Exec and ExecIn start a program with no shell, so run values stay values; Cmd inserts them verbatim. Commands keep at most 1 MiB per stream, report what they wrote when they time out, and finish when they exit even if something they started still holds the output.</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<PackageIconSourcePath>$(MSBuildThisFileDirectory)..\Modules\TestFramework-Common\Assets\Icon.png</PackageIconSourcePath>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
			<_Parameter1>TestFramework.LocalIO.Tests</_Parameter1>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!--
	  The package icon lives in the TestFramework-Common submodule. A clone that skips submodules
	  leaves it empty, and pack then fails with NuGet's opaque "icon file does not exist in the
	  package" / "Could not find a part of the path" error, which never mentions submodules.
	  Scoped to GenerateNuspec so ordinary builds and `dotnet test` stay unaffected.
	-->
	<Target Name="EnsurePackageIconSubmoduleIsInitialized" BeforeTargets="GenerateNuspec">
		<Error Condition="!Exists('$(PackageIconSourcePath)')"
		       Text="The package icon &quot;$(PackageIconSourcePath)&quot; is missing because the TestFramework-Common submodule is not checked out. Run 'git submodule update --init --recursive' in the repository root and pack again." />
	</Target>

	<ItemGroup>
	  <PackageReference Include="TestFramework.Core" Version="0.7.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
