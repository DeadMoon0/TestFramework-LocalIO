<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<Title>TestFramework.LocalIO</Title>
		<Version>0.4.0</Version>
		<Authors>DeadMoon0</Authors>
		<Product>TestFramework</Product>
		<Description>Manage your Local IO with a Framework Timeline.</Description>
		<PackageProjectUrl>https://github.com/DeadMoon0/TestFramework-LocalIO</PackageProjectUrl>
		<PackageIcon>Icon.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/DeadMoon0/TestFramework-LocalIO.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>Test;UnitTest;IntegrationTest;Framework;Fluent;Timeline;Local;IO</PackageTags>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<Copyright>Copyright (c) DeadMoon0 2026</Copyright>
		<PackageReleaseNotes>Aligned with TestFramework.Core 0.4.0's run contract, plus a hardening pass: artifact file IO now honours the run's deadline token, so a stalled read or write stops when the step does. Rooted-but-not-fully-qualified paths ("\results\out.txt", "C:out.txt") are refused by name instead of silently escaping the run directory onto the current drive. The run-directory cleanup only ever removes a directory RunDirectoryStep itself created, a second UseRunDirectory() in one run is refused, and FindArtifact refuses a folder holding more than one file instead of taking the first by enumeration order - use FindArtifacts for a folder of many. Declared IO contracts now state variable inputs as required, so a missing producer is refused at plan time with the fix named. Requires TestFramework.Core 0.4.0.</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup>
		<PackageIconSourcePath>$(MSBuildThisFileDirectory)..\Modules\TestFramework-Common\Assets\Icon.png</PackageIconSourcePath>
	</PropertyGroup>

	<ItemGroup>
		<None Include="$(PackageIconSourcePath)">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

	<!--
	  The package icon lives in the TestFramework-Common submodule. A clone that skips submodules
	  leaves it empty, and pack then fails with NuGet's opaque "icon file does not exist in the
	  package" / "Could not find a part of the path" error, which never mentions submodules.
	  Scoped to GenerateNuspec so ordinary builds and `dotnet test` stay unaffected.
	-->
	<Target Name="EnsurePackageIconSubmoduleIsInitialized" BeforeTargets="GenerateNuspec">
		<Error Condition="!Exists('$(PackageIconSourcePath)')"
		       Text="The package icon &quot;$(PackageIconSourcePath)&quot; is missing because the TestFramework-Common submodule is not checked out. Run 'git submodule update --init --recursive' in the repository root and pack again." />
	</Target>

	<ItemGroup>
	  <PackageReference Include="TestFramework.Core" Version="0.4.0" />
	</ItemGroup>

	<ItemGroup>
		<None Include="README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>

</Project>
